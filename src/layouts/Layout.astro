---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  assets,
  defaultDescription,
  defaultTitle,
  fontStylesheet,
  siteName,
  siteUrl,
  themeColor,
  type NavKey,
} from "../data";
import {
  buildOrganizationJsonLd,
  mergeJsonLdBlocks,
  resolveImageUrl,
} from "../data/seo";

interface Props {
  title?: string;
  description?: string;
  activePage?: NavKey | "none";
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = defaultTitle,
  description = defaultDescription,
  activePage = "home",
  image = assets.ogImage,
  type = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL(siteUrl);
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = resolveImageUrl(image, site);
const jsonLdBlocks = mergeJsonLdBlocks(
  buildOrganizationJsonLd(site, imageURL),
  jsonLd,
);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          const theme =
            stored === "light" || stored === "dark"
              ? stored
              : prefersDark
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontStylesheet} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href={assets.appleTouchIcon} />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} Blog`}
      href={new URL("/rss.xml", site)}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${siteName} — custom websites for businesses`}
    />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta
      name="twitter:image:alt"
      content={`${siteName} — custom websites for businesses`}
    />

    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body class="flex min-h-screen flex-col text-ink antialiased">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SiteHeader activePage={activePage} />

    <main
      id="main-content"
      class="content-stagger mx-auto w-full max-w-6xl flex-1 px-5 pb-16 pt-10 md:px-8 md:pb-24 md:pt-14"
      tabindex="-1"
    >
      <slot />
    </main>

    <SiteFooter activePage={activePage} />

    <script>
      import AOS from "aos";

      AOS.init({
        duration: 650,
        once: true,
        disable: () =>
          window.matchMedia("(prefers-reduced-motion: reduce)").matches,
      });
    </script>
  </body>
</html>
