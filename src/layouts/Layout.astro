---
import '../styles/global.css';
import {
	assets,
	defaultDescription,
	defaultTitle,
	legalLinks,
	navItems,
	organizationDescription,
	sameAs,
	siteEmail,
	siteName,
	siteUrl,
	type NavKey
} from '../data/site';

interface Props {
	title?: string;
	description?: string;
	activePage?: NavKey | 'none';
	image?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = defaultTitle,
	description = defaultDescription,
	activePage = 'home',
	image = assets.ogImage,
	type = 'website',
	noindex = false,
	jsonLd
} = Astro.props;

const site = Astro.site ?? new URL(siteUrl);
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL(image, site);
const fontStylesheet =
	'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap';

const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: siteName,
	url: site.href,
	logo: new URL(assets.logo, site).href,
	image: imageURL.href,
	description: organizationDescription,
	email: siteEmail,
	areaServed: 'Worldwide',
	sameAs: [...sameAs]
};

const jsonLdBlocks = [organizationJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={fontStylesheet} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href={assets.appleTouchIcon} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" type="application/rss+xml" title={`${siteName} Blog`} href={new URL('/rss.xml', site)} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#020617" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${siteName} — web, mobile, and desktop software`} />
		<meta property="og:locale" content="en_US" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content={`${siteName} — web, mobile, and desktop software`} />

		{
			jsonLdBlocks.map((block) => (
				<script type="application/ld+json" set:html={JSON.stringify(block)} />
			))
		}
	</head>
	<body class="flex min-h-screen flex-col bg-slate-950 text-slate-100 antialiased">
		<a href="#main-content" class="skip-link">Skip to main content</a>

		<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
			<div class="orb orb-cyan"></div>
			<div class="orb orb-violet"></div>
			<div class="grid-mask"></div>
		</div>

		<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/85 pt-[env(safe-area-inset-top,0px)] backdrop-blur-xl">
			<div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-3 px-4 py-3 pl-[max(1rem,env(safe-area-inset-left,0px))] pr-[max(1rem,env(safe-area-inset-right,0px))] md:px-8 md:py-4">
				<a href="/" class="brand-mark min-w-0" aria-label={`${siteName} home`}>
					<span class="brand-star" aria-hidden="true">✦</span>
					<span>{siteName}</span>
				</a>

				<button
					id="mobile-nav-toggle"
					type="button"
					class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-lg border border-white/20 bg-slate-900/70 p-2 text-slate-100 transition hover:border-violet-500 md:hidden"
					aria-expanded="false"
					aria-controls="mobile-nav"
				>
					<span class="sr-only" data-menu-label>Open navigation menu</span>
					<svg data-icon="open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M4 7h16"></path>
						<path d="M4 12h16"></path>
						<path d="M4 17h16"></path>
					</svg>
					<svg data-icon="close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M6 6l12 12"></path>
						<path d="M18 6L6 18"></path>
					</svg>
				</button>

				<nav aria-label="Main navigation" class="hidden md:block">
					<ul class="flex flex-wrap items-center gap-1 rounded-full border border-white/15 bg-white/5 p-1 text-sm md:text-base">
						{
							navItems.map((item) => (
								<li>
									<a
										href={item.href}
										class:list={[
											'nav-link',
											activePage === item.key && 'nav-link-active'
										]}
										aria-current={activePage === item.key ? 'page' : undefined}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>

			<div id="mobile-nav" class="mx-auto hidden w-full max-w-6xl px-4 pb-4 pl-[max(1rem,env(safe-area-inset-left,0px))] pr-[max(1rem,env(safe-area-inset-right,0px))] md:hidden md:px-8">
				<nav aria-label="Mobile navigation">
					<ul class="grid gap-1 rounded-2xl border border-white/15 bg-white/5 p-2 text-sm">
						{
							navItems.map((item) => (
								<li>
									<a
										href={item.href}
										class:list={[
											'nav-link w-full justify-start',
											activePage === item.key && 'nav-link-active'
										]}
										aria-current={activePage === item.key ? 'page' : undefined}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main
			id="main-content"
			class="content-stagger mx-auto w-full max-w-6xl flex-1 px-4 pb-16 pt-8 pl-[max(1rem,env(safe-area-inset-left,0px))] pr-[max(1rem,env(safe-area-inset-right,0px))] md:px-8 md:pb-24 md:pt-14"
			tabindex="-1"
		>
			<slot />
		</main>

		<footer class="border-t border-white/10 bg-slate-950/90 pb-[env(safe-area-inset-bottom,0px)]">
			<div class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-8 pl-[max(1rem,env(safe-area-inset-left,0px))] pr-[max(1rem,env(safe-area-inset-right,0px))] text-sm text-slate-300 md:px-8">
				<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
					<p>© {new Date().getFullYear()} {siteName}. Built with modern TypeScript tooling.</p>
					<p>Remote-first delivery for startups, agencies, and internal product teams.</p>
				</div>
				<nav aria-label="Legal navigation">
					<ul class="flex flex-wrap gap-2 text-sm text-slate-400">
						{
							legalLinks.map((link) => (
								<li>
									<a href={link.href} class="inline-flex min-h-11 items-center transition hover:text-cyan-300">{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</footer>

		<script is:inline>
			const toggleButton = document.getElementById('mobile-nav-toggle');
			const mobileNav = document.getElementById('mobile-nav');

			if (toggleButton && mobileNav) {
				const label = toggleButton.querySelector('[data-menu-label]');
				const openIcon = toggleButton.querySelector('[data-icon="open"]');
				const closeIcon = toggleButton.querySelector('[data-icon="close"]');
				const menuLinks = mobileNav.querySelectorAll('a');

				const setOpen = (open) => {
					mobileNav.classList.toggle('hidden', !open);
					toggleButton.setAttribute('aria-expanded', open ? 'true' : 'false');
					if (label) {
						label.textContent = open ? 'Close navigation menu' : 'Open navigation menu';
					}
					openIcon?.classList.toggle('hidden', open);
					closeIcon?.classList.toggle('hidden', !open);
				};

				const closeMenu = () => setOpen(false);

				toggleButton.addEventListener('click', () => {
					const willOpen = mobileNav.classList.contains('hidden');
					setOpen(willOpen);
				});

				menuLinks.forEach((link) => {
					link.addEventListener('click', closeMenu);
				});

				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && !mobileNav.classList.contains('hidden')) {
						closeMenu();
						toggleButton.focus();
					}
				});

				window.addEventListener('resize', () => {
					if (window.innerWidth >= 768) {
						closeMenu();
					}
				});
			}
		</script>
	</body>
</html>
