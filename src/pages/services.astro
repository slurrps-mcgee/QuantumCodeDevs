---
import CtaBand from "../components/CtaBand.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SurfaceCard from "../components/SurfaceCard.astro";
import { services } from "../data";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={services.meta.title}
  description={services.meta.description}
  activePage="services"
>
  <SectionHeader
    animate
    eyebrow={services.servicePage.eyebrow}
    title={services.servicePage.title}
    description={services.servicePage.description}
  />

  <SurfaceCard animate class="mt-10" as="section">
    <p class="kicker">Primary service</p>
    <h2 class="mt-3 text-3xl font-semibold">
      {services.servicePage.primary.title}
    </h2>
    <p class="mt-4 max-w-3xl text-muted">{services.servicePage.primary.body}</p>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        services.websiteIncludes.map((item) => (
          <li class="flex items-start gap-3 text-muted">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-mauve" />
            {item}
          </li>
        ))
      }
    </ul>
  </SurfaceCard>

  <div class="mt-6 grid gap-4 lg:grid-cols-2">
    <SurfaceCard animate delayIndex={1}>
      <p class="kicker">Pricing</p>
      <h2 class="mt-3 text-3xl font-semibold">{services.pricing.headline}</h2>
      <p class="mt-4 text-muted">{services.pricing.body}</p>
      <p class="mt-4 text-sm text-muted">
        {services.servicePage.hourlyRateNote}
      </p>
    </SurfaceCard>
    <SurfaceCard animate delayIndex={2}>
      <p class="kicker">Beyond a website</p>
      <h2 class="mt-3 text-3xl font-semibold">
        {services.servicePage.secondaryTitle}
      </h2>
      <p class="mt-4 text-muted">{services.servicePage.secondary}</p>
    </SurfaceCard>
  </div>

  <section class="mt-10">
    <SectionHeader
      animate
      titleTag="h2"
      eyebrow="Process"
      title={services.servicePage.processSectionTitle}
      class="mb-8"
    />
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        services.processSteps.map((step, index) => (
          <SurfaceCard animate delayIndex={index}>
            <p class="kicker">{step.step}</p>
            <h3 class="mt-3 text-xl font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm text-muted">{step.description}</p>
          </SurfaceCard>
        ))
      }
    </div>
  </section>

  <div class="mt-16">
    <CtaBand />
  </div>
</Layout>
