---
import CtaBand from "../components/CtaBand.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SurfaceCard from "../components/SurfaceCard.astro";
import { featuredProjects } from "../data/projects";
import { home } from "../data";
import Layout from "../layouts/Layout.astro";
import { aosAttrs } from "../lib/aos";
---

<Layout
  title={home.meta.title}
  description={home.meta.description}
  activePage="home"
>
  <section class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
    <SectionHeader
      animate
      eyebrow={home.hero.eyebrow}
      title={home.hero.title}
      description={home.hero.description}
      titleClass="text-4xl font-semibold leading-[1.05] sm:text-5xl md:text-6xl"
    >
      <div
        class="flex flex-col gap-3 pt-2 sm:flex-row"
        {...aosAttrs("fadeIn", 2)}
      >
        <a href={home.hero.primaryCta.href} class="btn-primary"
          >{home.hero.primaryCta.label}</a
        >
        <a href={home.hero.secondaryCta.href} class="btn-secondary"
          >{home.hero.secondaryCta.label}</a
        >
      </div>
    </SectionHeader>
    <SurfaceCard
      animate
      animation="fadeInRight"
      delayIndex={1}
      class="bg-wash/70"
    >
      <p class="kicker">{home.pricingCard.kicker}</p>
      <p class="mt-3 font-display text-4xl font-semibold">
        {home.pricing.startingAt}
      </p>
      <p class="mt-3 text-muted">{home.pricingCard.body}</p>
    </SurfaceCard>
  </section>

  <section class="mt-16 md:mt-20" aria-labelledby="credibility-heading">
    <h2 id="credibility-heading" class="sr-only">
      {home.credibilityHeading}
    </h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        home.credibilityItems.map((item, index) => (
          <SurfaceCard animate delayIndex={index}>
            <p class="kicker">{item.label}</p>
            <h3 class="mt-3 text-xl font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm text-muted">{item.description}</p>
          </SurfaceCard>
        ))
      }
    </div>
  </section>

  <section
    class="mt-16 grid gap-8 md:mt-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-start"
  >
    <SectionHeader
      animate
      titleTag="h2"
      eyebrow={home.servicesPreview.eyebrow}
      title={home.servicesPreview.title}
      description={home.servicesPreview.description}
    />
    <SurfaceCard animate delayIndex={1}>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          home.websiteIncludes.map((item) => (
            <li class="flex items-start gap-3 text-muted">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-mauve" />
              {item}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-muted">{home.servicesPreview.footerNote}</p>
      <a
        href="/services"
        class="mt-5 inline-flex min-h-11 items-center font-semibold text-cta hover:underline"
        >{home.servicesPreview.linkLabel}</a
      >
    </SurfaceCard>
  </section>

  <section class="mt-16 md:mt-20">
    <div
      class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    >
      <SectionHeader
        animate
        titleTag="h2"
        eyebrow={home.workPreview.eyebrow}
        title={home.workPreview.title}
        description={home.workPreview.description}
      />
      <a href="/work" class="btn-secondary shrink-0"
        >{home.workPreview.linkLabel}</a
      >
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        featuredProjects.map((project, index) => (
          <ProjectCard project={project} delayIndex={index} />
        ))
      }
    </div>
  </section>

  <section class="mt-16 md:mt-20">
    <SectionHeader
      animate
      titleTag="h2"
      eyebrow={home.processPreview.eyebrow}
      title={home.processPreview.title}
      class="mb-8"
    />
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        home.processSteps.map((step, index) => (
          <SurfaceCard animate delayIndex={index}>
            <p class="kicker">{step.step}</p>
            <h3 class="mt-3 text-xl font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm text-muted">{step.description}</p>
          </SurfaceCard>
        ))
      }
    </div>
  </section>

  <section class="mt-16 grid gap-6 md:mt-20 lg:grid-cols-2">
    <SurfaceCard animate class="bg-blush/50">
      <p class="kicker">Pricing</p>
      <h2 class="mt-3 text-3xl font-semibold">{home.pricing.headline}</h2>
      <p class="mt-4 text-muted">{home.pricing.body}</p>
    </SurfaceCard>
    <SurfaceCard animate delayIndex={1}>
      <p class="kicker">{home.aboutPreview.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold">{home.aboutPreview.title}</h2>
      <p class="mt-4 text-muted">{home.aboutPreview.body}</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href={home.aboutPreview.cta.href} class="btn-primary"
          >{home.aboutPreview.cta.label}</a
        >
        <a
          href={home.aboutPreview.portfolioHref}
          class="btn-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Kenneth's portfolio <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
    </SurfaceCard>
  </section>

  <div class="mt-16 md:mt-20">
    <CtaBand />
  </div>
</Layout>
