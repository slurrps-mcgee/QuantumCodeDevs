---
import GlassCard from '../components/GlassCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
	homeQuickLinks,
	homeServiceCards,
	pageMeta,
	processSteps,
	technologyColumns
} from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title={pageMeta.home.title}
	description={pageMeta.home.description}
	activePage="home"
>
	<section class="grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
		<div>
			<SectionHeader
				eyebrow="Practical Digital Delivery"
				title="We build websites and bespoke software that stay within scope and deliver real business value."
				description="Quantum Code Devs is a solo LLC focused on websites and custom software applications. I keep the offering intentionally narrow so I can deliver well, while also bringing strong C# and .NET experience when a project needs it."
				eyebrowClass="inline-flex rounded-full border border-cyan-200/30 bg-cyan-200/10 px-4 py-1 text-xs font-medium uppercase tracking-[0.22em] text-cyan-100"
				titleClass="text-4xl font-semibold leading-tight text-white md:text-6xl"
				descriptionClass="max-w-2xl text-lg text-slate-300"
			/>
			<div class="flex flex-wrap gap-3 mt-4">
				<a href="/services" class="btn-primary">Explore Services</a>
				<a href="/contact" class="btn-secondary">Book a Discovery Call</a>
			</div>
		</div>

		<div class="glass-card space-y-5">
			<p class="text-xs uppercase tracking-[0.2em] text-cyan-100">Delivery Snapshot</p>
			<ul class="space-y-3 text-sm text-slate-200">
				<li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 rounded-full bg-cyan-300"></span>Full-cycle web engineering with Angular, TypeScript, and NestJS APIs.</li>
				<li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 rounded-full bg-violet-300"></span>Cross-platform app development for mobile and desktop experiences.</li>
				<li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 rounded-full bg-cyan-300"></span>Transparent process: roadmap, weekly demos, launch support.</li>
				<li class="flex items-start gap-3"><span class="mt-2 h-2 w-2 rounded-full bg-violet-300"></span>C# and .NET development when a solution fits that platform better.</li>
			</ul>
			<div class="rounded-xl border border-white/10 bg-slate-900/70 p-4 text-sm text-slate-300">
				<p class="font-semibold text-white">Need a fast estimate?</p>
				<p>Most MVP projects begin in the $15k-$50k range, depending on scope and integrations.</p>
			</div>
		</div>
	</section>

	<section class="mt-14" aria-labelledby="home-services-heading">
		<h2 id="home-services-heading" class="sr-only">Core services</h2>
		<div class="grid gap-4 md:grid-cols-3">
			{
				homeServiceCards.map((card) => (
					<GlassCard title={card.title} titleTag="h3" titleClass="text-2xl font-semibold text-white">
						<p>{card.description}</p>
					</GlassCard>
				))
			}
		</div>
	</section>

	<section class="mt-14">
		<SectionHeader
			titleTag="h2"
			eyebrow="How We Work"
			title="A practical process designed for shipping, not stalling."
			class="mb-6"
			titleClass="mt-2 text-3xl font-semibold text-white md:text-4xl"
		/>

		<div class="grid gap-4 md:grid-cols-4">
			{
				processSteps.map((step) => (
					<GlassCard title={step.title} titleTag="h3" titleClass="mt-2 text-xl font-semibold text-white" bodyClass="mt-2 text-sm text-slate-300">
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-violet-300">{step.step}</p>
						<p>{step.description}</p>
					</GlassCard>
				))
			}
		</div>
	</section>

	<section class="mt-14">
		<SectionHeader
			titleTag="h2"
			eyebrow="Technology Stack"
			title="Primary stack for production-grade web, mobile, and desktop products."
			class="mb-6"
			titleClass="mt-2 text-3xl font-semibold text-white md:text-4xl"
		/>

		<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
			{
				technologyColumns.map((column) => (
					<GlassCard title={column.title} titleTag="h3" titleClass="text-lg font-semibold text-white" bodyClass="mt-2 text-sm text-slate-300">
						<p>{column.description}</p>
					</GlassCard>
				))
			}
		</div>

		<div class="mt-4 rounded-xl border border-cyan-300/20 bg-cyan-300/5 p-4 text-sm text-slate-200">
			<p><strong class="text-white">Core stack includes:</strong> Astro + Tailwind delivery for marketing sites, content platforms, and custom web applications.</p>
		</div>
	</section>

	<section class="mt-14 grid gap-4 lg:grid-cols-[0.95fr_1.05fr]">
		<article class="glass-card">
			<p class="text-xs uppercase tracking-[0.2em] text-cyan-200">Founder Profile</p>
			<h2 class="mt-2 text-3xl font-semibold text-white">Built by one developer, with a focused service model.</h2>
			<p class="mt-3 text-slate-300">This business is intentionally lean: one experienced developer, clear communication, and a realistic workload so projects stay manageable and high quality.</p>
			<div class="mt-4 flex flex-wrap gap-3">
				<a href="/developers" class="btn-primary">View Developer Profile</a>
			</div>
		</article>

		<article class="glass-card">
			<h2 class="text-2xl font-semibold text-white">Quick Links</h2>
			<div class="mt-4 grid gap-3 sm:grid-cols-2">
				{
					homeQuickLinks.map((link) => (
						<a
							href={link.href}
							target="_blank"
							rel="noopener noreferrer"
							class:list={[
								'rounded-xl border border-white/10 bg-slate-900/55 p-4 text-slate-200 transition',
								link.hoverClass
							]}
						>
							<p class:list={['text-xs uppercase tracking-[0.16em]', link.textClass]}>{link.label}</p>
							<p class="mt-2 font-semibold">
								{link.title} <span class="sr-only">(opens in a new tab)</span>
							</p>
						</a>
					))
				}
			</div>
		</article>
	</section>
</Layout>
