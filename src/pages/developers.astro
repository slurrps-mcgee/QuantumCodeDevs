---
import GlassCard from '../components/GlassCard.astro';
import InsetCard from '../components/InsetCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
	developerLinks,
	developerStrengths,
	pageMeta,
	siteName,
	urls
} from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title={pageMeta.developers.title}
  description={pageMeta.developers.description}
  activePage="developers"
>
  <SectionHeader
    eyebrow="Developer Profile"
    title={`The developer behind ${siteName}.`}
    description="For now, the business is just one developer: a solo founder focused on delivering websites, bespoke software applications, and Astro-powered platforms as a core offering."
  />

  <section class="mt-10 grid grid-cols-1 gap-6 md:mt-14 lg:grid-cols-[0.9fr_1.1fr]">
    <GlassCard>
      <div class="h-40 rounded-xl border border-white/10 bg-gradient-to-br from-cyan-500/20 to-violet-500/20"></div>
      <h2 class="mt-4 text-2xl font-semibold text-white">Kenneth Lamb: Solo Founder</h2>
      <p class="mt-3 text-slate-300">
        Direct communication, fast decisions, and a realistic delivery model keep projects moving without the overhead of a larger agency.
      </p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={urls.portfolio} target="_blank" rel="noopener noreferrer" class="btn-primary w-full sm:w-auto">
          {siteName} Portfolio <span class="sr-only">(opens in a new tab)</span>
        </a>
        <a href={urls.github} target="_blank" rel="noopener noreferrer" class="btn-secondary w-full sm:w-auto">
          GitHub <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
    </GlassCard>

    <GlassCard class="space-y-4" title="Core Strengths">
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          developerStrengths.map((strength) => (
            <InsetCard>
              <h3 class="font-semibold text-white">{strength.title}</h3>
              <p class="mt-2 text-sm text-slate-300">{strength.description}</p>
            </InsetCard>
          ))
        }
      </div>
    </GlassCard>
  </section>

  <GlassCard as="section" class="mt-10 md:mt-14" title="What I Typically Link To">
    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {
        developerLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class:list={['rounded-xl border border-white/10 bg-slate-900/55 p-4 transition', link.hoverClass]}>
            <p class:list={['text-xs uppercase tracking-[0.16em]', link.textClass]}>{link.label}</p>
            <p class="mt-2 text-slate-200">{link.description} <span class="sr-only">(opens in a new tab)</span></p>
          </a>
        ))
      }
    </div>
  </GlassCard>
</Layout>
