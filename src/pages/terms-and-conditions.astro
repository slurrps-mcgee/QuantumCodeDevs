---
import SectionHeader from "../components/SectionHeader.astro";
import SurfaceCard from "../components/SurfaceCard.astro";
import { legal } from "../data";
import Layout from "../layouts/Layout.astro";

const policy = legal.terms;
---

<Layout
  title={policy.meta.title}
  description={policy.meta.description}
  activePage="none"
>
  <SectionHeader
    animate
    eyebrow={policy.eyebrow}
    title={policy.title}
    description={policy.description}
  />
  <p class="mt-4 text-sm text-muted">Last updated: {policy.lastUpdated}</p>

  <div class="mt-10 grid gap-4">
    {
      policy.sections.map((section, index) => (
        <SurfaceCard
          animate
          delayIndex={Math.min(index, 4)}
          title={section.title}
        >
          {section.paragraphs?.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </SurfaceCard>
      ))
    }
  </div>
</Layout>
