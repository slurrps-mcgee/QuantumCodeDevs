---
import SectionHeader from "../components/SectionHeader.astro";
import SurfaceCard from "../components/SurfaceCard.astro";
import { contact, siteEmail } from "../data";
import Layout from "../layouts/Layout.astro";
import { aosAttrs } from "../lib/aos";

const formEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT ?? "";
const hasEndpoint = Boolean(formEndpoint);
---

<Layout
  title={contact.meta.title}
  description={contact.meta.description}
  activePage="contact"
>
  <section class="grid gap-8 lg:grid-cols-[1fr_1fr]">
    <div class="space-y-5">
      <SectionHeader
        animate
        eyebrow={contact.contactPage.eyebrow}
        title={contact.contactPage.title}
        description={contact.contactPage.description}
      />
      <SurfaceCard animate>
        <p>
          <strong class="text-ink">Email:</strong>
          <a
            class="underline-offset-4 hover:underline"
            href={`mailto:${siteEmail}`}>{siteEmail}</a
          >
        </p>
        <p class="mt-3">
          <strong class="text-ink">{contact.contactPage.locationLabel}:</strong>
          {contact.contactPage.locationValue}
        </p>
      </SurfaceCard>
      <SurfaceCard
        animate
        delayIndex={1}
        title="What happens next"
        titleTag="h2"
        titleClass="text-xl font-semibold"
      >
        <ol class="space-y-2 text-sm">
          {
            contact.contactPage.afterSubmit.map((item, index) => (
              <li>
                {index + 1}. {item}
              </li>
            ))
          }
        </ol>
      </SurfaceCard>
    </div>

    <form
      class="surface-card space-y-4"
      {...aosAttrs("fadeIn", 1)}
      method="post"
      action={hasEndpoint ? formEndpoint : `mailto:${siteEmail}`}
      enctype={hasEndpoint ? undefined : "text/plain"}
      aria-labelledby="contact-form-heading"
    >
      <h2 id="contact-form-heading" class="text-xl font-semibold">
        Project inquiry
      </h2>
      <p class="text-sm text-muted">
        Required fields are marked with <span aria-hidden="true">*</span><span
          class="sr-only">asterisk</span
        >.
      </p>

      {
        hasEndpoint ? (
          <input
            type="hidden"
            name="_subject"
            value={contact.contactForm.subject}
          />
        ) : (
          <p
            class="rounded-xl border border-mauve/40 bg-blush/60 px-3 py-2 text-sm"
            role="status"
          >
            The form endpoint is not configured yet, so submit will open your
            email app. Set <strong>PUBLIC_CONTACT_FORM_ENDPOINT</strong> to
            connect Formspree.
          </p>
        )
      }

      <div>
        <label for="name" class="mb-1 block text-sm font-medium">
          Name <span class="text-mauve" aria-hidden="true">*</span>
        </label>
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          required
          class="form-control"
        />
      </div>

      <div>
        <label for="email" class="mb-1 block text-sm font-medium">
          Email <span class="text-mauve" aria-hidden="true">*</span>
        </label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="form-control"
        />
      </div>

      <div>
        <label for="company" class="mb-1 block text-sm font-medium"
          >Company / organization</label
        >
        <input
          id="company"
          name="company"
          type="text"
          autocomplete="organization"
          class="form-control"
        />
      </div>

      <div>
        <label for="currentWebsite" class="mb-1 block text-sm font-medium"
          >Current website, if you have one</label
        >
        <input
          id="currentWebsite"
          name="currentWebsite"
          type="url"
          inputmode="url"
          placeholder="https://"
          class="form-control"
        />
      </div>

      <div>
        <label for="websiteType" class="mb-1 block text-sm font-medium"
          >What kind of website do you need?</label
        >
        <select id="websiteType" name="websiteType" class="form-control">
          {
            contact.contactForm.websiteTypes.map((option) => (
              <option>{option}</option>
            ))
          }
        </select>
      </div>

      <div>
        <label for="budget" class="mb-1 block text-sm font-medium"
          >Budget range</label
        >
        <select id="budget" name="budget" class="form-control">
          {
            contact.contactForm.budgets.map((option) => (
              <option>{option}</option>
            ))
          }
        </select>
      </div>

      <div>
        <label for="timeline" class="mb-1 block text-sm font-medium"
          >Timeline</label
        >
        <select id="timeline" name="timeline" class="form-control">
          {
            contact.contactForm.timelines.map((option) => (
              <option>{option}</option>
            ))
          }
        </select>
      </div>

      <div>
        <label for="message" class="mb-1 block text-sm font-medium">
          Project details <span class="text-mauve" aria-hidden="true">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          class="form-control min-h-32"
          placeholder={contact.contactForm.messagePlaceholder}></textarea>
      </div>

      <button type="submit" class="btn-primary w-full">Start a Project</button>
      <p class="text-xs text-muted">
        By submitting, you agree to be contacted about this website inquiry.
      </p>
    </form>
  </section>
</Layout>
