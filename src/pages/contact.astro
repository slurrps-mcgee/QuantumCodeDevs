---
import GlassCard from '../components/GlassCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { contactForm, pageMeta, siteEmail } from '../data/site';
import Layout from '../layouts/Layout.astro';

const contactEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT ?? '';
const hasEndpoint = Boolean(contactEndpoint);
---

<Layout
  title={pageMeta.contact.title}
  description={pageMeta.contact.description}
  activePage="contact"
>
  <section class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="space-y-5">
      <SectionHeader
        eyebrow="Let's Build Together"
        title="Tell us what you are building and where you need support."
        description="Share your goals, timeline, and platform priorities. We typically respond within one business day with a suggested engagement model, estimate range, and proposed next steps."
        eyebrowClass="inline-flex rounded-full border border-violet-200/30 bg-violet-200/10 px-4 py-1 text-xs font-medium uppercase tracking-[0.22em] text-violet-100"
        descriptionClass="max-w-xl text-lg text-slate-300"
      />

      <GlassCard bodyClass="space-y-3 text-slate-300">
        <p><strong class="text-white">Email:</strong> {siteEmail}</p>
        <p><strong class="text-white">Location:</strong> Remote team, global delivery</p>
        <p><strong class="text-white">Availability:</strong> New projects starting each month</p>
      </GlassCard>

      <GlassCard
        title="What Happens After You Submit"
        titleTag="h2"
        titleClass="text-xl font-semibold text-white"
        bodyClass="mt-4 text-slate-300"
      >
        <ul class="space-y-2 text-sm">
          <li>1. We review your goals, constraints, and required platforms.</li>
          <li>2. We share a recommended build approach and initial estimate.</li>
          <li>3. We schedule a short discovery call to finalize scope and milestones.</li>
        </ul>
      </GlassCard>

      <GlassCard
        title="Typical Project Inputs"
        titleTag="h2"
        titleClass="text-xl font-semibold text-white"
        bodyClass="mt-3 space-y-3 text-sm text-slate-300"
      >
        <p><strong class="text-white">Business goals:</strong> Revenue growth, workflow automation, customer experience improvements.</p>
        <p><strong class="text-white">Primary platforms:</strong> Angular web, Ionic mobile, Electron desktop, NestJS backend.</p>
        <p><strong class="text-white">Delivery style:</strong> Fixed-scope milestones or ongoing monthly product support.</p>
      </GlassCard>
    </div>

    <form
      class="glass-card space-y-4"
      method="post"
      action={hasEndpoint ? contactEndpoint : `mailto:${siteEmail}`}
      enctype={hasEndpoint ? undefined : 'text/plain'}
      aria-labelledby="contact-form-heading"
    >
      <h2 id="contact-form-heading" class="text-xl font-semibold text-white">Project inquiry form</h2>
      <p class="text-sm text-slate-400">
        Required fields are marked with <span aria-hidden="true">*</span><span class="sr-only">asterisk</span>.
      </p>

      {
        hasEndpoint ? (
          <>
            <input type="hidden" name="_subject" value={contactForm.subject} />
            <input type="hidden" name="_captcha" value="false" />
          </>
        ) : (
          <p class="rounded-lg border border-amber-300/30 bg-amber-300/10 px-3 py-2 text-sm text-amber-100" role="status">
            Form endpoint not configured yet. Submitting will open your email client. Set <strong>PUBLIC_CONTACT_FORM_ENDPOINT</strong> to connect Formspree.
          </p>
        )
      }

      <div>
        <label for="name" class="mb-1 block text-sm font-medium text-slate-200">
          Name <span class="text-cyan-300" aria-hidden="true">*</span>
        </label>
        <input id="name" name="name" type="text" autocomplete="name" required aria-required="true" class="form-control" />
      </div>

      <div>
        <label for="email" class="mb-1 block text-sm font-medium text-slate-200">
          Email <span class="text-cyan-300" aria-hidden="true">*</span>
        </label>
        <input id="email" name="email" type="email" autocomplete="email" required aria-required="true" class="form-control" />
      </div>

      <div>
        <label for="company" class="mb-1 block text-sm font-medium text-slate-200">Company (Optional)</label>
        <input id="company" name="company" type="text" autocomplete="organization" class="form-control" />
      </div>

      <div>
        <label for="projectType" class="mb-1 block text-sm font-medium text-slate-200">Project Type</label>
        <select id="projectType" name="projectType" class="form-control">
          {contactForm.projectTypes.map((option) => <option>{option}</option>)}
        </select>
      </div>

      <fieldset>
        <legend class="mb-2 block text-sm font-medium text-slate-200">Services Needed</legend>
        <div class="grid gap-2 text-sm text-slate-300 sm:grid-cols-2">
          {
            contactForm.services.map((service) => (
              <label class="flex min-h-11 items-center gap-3">
                <input type="checkbox" name="services" value={service} class="h-5 w-5 rounded border-white/30 bg-slate-900/70" />
                {service}
              </label>
            ))
          }
        </div>
      </fieldset>

      <div>
        <label for="budget" class="mb-1 block text-sm font-medium text-slate-200">Estimated Budget</label>
        <select id="budget" name="budget" class="form-control">
          {contactForm.budgets.map((option) => <option>{option}</option>)}
        </select>
      </div>

      <div>
        <label for="timeline" class="mb-1 block text-sm font-medium text-slate-200">Target Timeline</label>
        <select id="timeline" name="timeline" class="form-control">
          {contactForm.timelines.map((option) => <option>{option}</option>)}
        </select>
      </div>

      <div>
        <label for="message" class="mb-1 block text-sm font-medium text-slate-200">
          Project Details <span class="text-cyan-300" aria-hidden="true">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          aria-required="true"
          class="form-control"
          placeholder={contactForm.messagePlaceholder}
        ></textarea>
      </div>

      <button type="submit" class="w-full rounded-lg bg-cyan-300 px-4 py-3 font-semibold text-slate-900 transition hover:bg-cyan-200">
        Submit Project Inquiry
      </button>

      <p class="text-xs text-slate-400">By submitting this form, you agree to be contacted about your project inquiry.</p>
    </form>
  </section>
</Layout>
