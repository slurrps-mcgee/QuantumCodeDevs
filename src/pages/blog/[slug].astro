---
import SectionHeader from "../../components/SectionHeader.astro";
import SurfaceCard from "../../components/SurfaceCard.astro";
import { getRelatedBlogPosts, getBlogStaticPaths } from "../../data/blog";
import { buildArticleJsonLd, buildBlogPostMeta } from "../../data/seo";
import { siteUrl } from "../../data";
import Layout from "../../layouts/Layout.astro";
import { render } from "astro:content";
import { aosAttrs } from "../../lib/aos";

export const getStaticPaths = getBlogStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const site = Astro.site ?? new URL(siteUrl);
const related = await getRelatedBlogPosts(post.id);
const pageMeta = buildBlogPostMeta(post.data.title, post.data.description);
const articleJsonLd = buildArticleJsonLd(post, site);
---

<Layout
  title={pageMeta.title}
  description={pageMeta.description}
  activePage="blog"
  type="article"
  jsonLd={articleJsonLd}
>
  <p class="mb-8">
    <a
      href="/blog"
      class="inline-flex min-h-11 items-center text-sm font-semibold text-cta hover:underline"
      >← All posts</a
    >
  </p>
  <SectionHeader
    animate
    eyebrow={post.data.category}
    title={post.data.title}
    description={`Published ${post.data.publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}`}
  />
  <SurfaceCard animate class="prose-studio mt-10" as="article">
    <Content />
  </SurfaceCard>
  {
    related.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-semibold">More posts</h2>
        <div class="mt-5 grid gap-4">
          {related.map((item, index) => (
            <a
              href={`/blog/${item.id}`}
              class="surface-card hover:border-mauve"
              {...aosAttrs("fadeIn", index)}
            >
              <h3 class="text-xl font-semibold">{item.data.title}</h3>
              <p class="mt-2 text-muted">{item.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Layout>
