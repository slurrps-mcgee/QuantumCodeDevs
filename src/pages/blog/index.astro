---
import SectionHeader from "../../components/SectionHeader.astro";
import { getSortedBlogPosts } from "../../data/blog";
import { blogPage } from "../../data";
import Layout from "../../layouts/Layout.astro";
import { aosAttrs } from "../../lib/aos";

const posts = await getSortedBlogPosts();
---

<Layout
  title={blogPage.meta.title}
  description={blogPage.meta.description}
  activePage="blog"
>
  <SectionHeader
    animate
    eyebrow={blogPage.blogPage.eyebrow}
    title={blogPage.blogPage.title}
    description={blogPage.blogPage.description}
  />

  {
    posts.length > 0 ? (
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => (
          <a
            href={`/blog/${post.id}`}
            class="surface-card group flex h-full min-h-11 flex-col hover:border-mauve"
            {...aosAttrs("fadeInUp", index)}
          >
            <h2 class="text-xl font-semibold group-hover:text-cta">
              {post.data.title}
            </h2>
            <p class="mt-3 flex-1 text-muted">{post.data.description}</p>
            <p class="mt-4 text-sm text-mauve">
              {post.data.publishDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </p>
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-10 text-muted">{blogPage.blogPage.emptyMessage}</p>
    )
  }
</Layout>
