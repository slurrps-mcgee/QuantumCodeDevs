---
import SectionHeader from '../../components/SectionHeader.astro';
import { pageMeta } from '../../data/site';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<Layout title={pageMeta.blog.title} description={pageMeta.blog.description} activePage="blog">
	<SectionHeader
		eyebrow="Blog"
		title="Writing from the studio."
		description="Sample posts live here for now. They will be replaced with real articles over time."
	/>

	{
		posts.length > 0 ? (
			<div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => (
					<a href={`/blog/${post.id}`} class="surface-card group flex h-full min-h-11 flex-col hover:border-mauve">
						<h2 class="text-xl font-semibold group-hover:text-cta">{post.data.title}</h2>
						<p class="mt-3 flex-1 text-muted">{post.data.description}</p>
						<p class="mt-4 text-sm text-mauve">
							{post.data.publishDate.toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								day: 'numeric'
							})}
						</p>
					</a>
				))}
			</div>
		) : (
			<p class="mt-10 text-muted">No posts published yet.</p>
		)
	}
</Layout>
