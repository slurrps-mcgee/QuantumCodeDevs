---
import GlassCard from '../components/GlassCard.astro';
import InsetCard from '../components/InsetCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
	deliveryModel,
	engagements,
	industries,
	pageMeta,
	servicePillars
} from '../data/site';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title={pageMeta.about.title}
  description={pageMeta.about.description}
  activePage="about"
>
  <section class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
    <SectionHeader
      eyebrow="About Quantum Code Devs"
      title="We build practical digital products as a solo LLC, with a scope that stays realistic and focused."
      description="Quantum Code Devs partners with founders, business owners, and internal teams to design, build, and scale web, mobile, and desktop software. The business is currently just me, which keeps communication direct and the delivery model honest."
      eyebrowClass="inline-flex max-w-full text-wrap rounded-full border border-violet-200/30 bg-violet-200/10 px-3 py-1 text-xs font-medium uppercase tracking-wide text-violet-100 sm:px-4 sm:tracking-[0.22em]"
    >
      <p class="text-slate-300">
        My core strengths are Astro, Angular, Ionic, Electron, NestJS, MySQL, and C# / .NET when the project calls for it, so I can match the technology to the problem instead of forcing one stack everywhere.
      </p>
    </SectionHeader>

    <aside class="glass-card">
      <h2 class="text-2xl font-semibold text-white">What We Stand For</h2>
      <ul class="mt-4 space-y-3 text-sm text-slate-200">
        <li><strong class="text-white">Clarity:</strong> We define scope and milestones before writing production code.</li>
        <li><strong class="text-white">Craft:</strong> We focus on architecture, maintainability, and user experience quality.</li>
        <li><strong class="text-white">Velocity:</strong> We ship in small, testable increments with weekly demos.</li>
        <li><strong class="text-white">Ownership:</strong> We communicate proactively and treat your product goals as shared goals.</li>
        <li><strong class="text-white">Focus:</strong> We only take on work we can deliver well, rather than overextending the business.</li>
      </ul>
    </aside>
  </section>

  <section class="mt-10 md:mt-12" aria-labelledby="about-pillars-heading">
    <h2 id="about-pillars-heading" class="sr-only">Service pillars</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        servicePillars.map((pillar) => (
          <GlassCard title={pillar.title} titleTag="h3" titleClass="text-xl font-semibold text-white">
            <p>{pillar.description}</p>
          </GlassCard>
        ))
      }
    </div>
  </section>

  <GlassCard as="section" class="mt-10 md:mt-12" title="Our Delivery Model">
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        deliveryModel.map((item) => (
          <InsetCard>
            <h3 class="text-lg font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-300">{item.description}</p>
          </InsetCard>
        ))
      }
    </div>
  </GlassCard>

  <section class="mt-10 grid grid-cols-1 gap-4 md:mt-12 lg:grid-cols-2">
    <GlassCard title="Industries We Commonly Support">
      <ul class="mt-4 space-y-3 text-slate-300">
        {industries.map((industry) => <li>{industry}</li>)}
      </ul>
    </GlassCard>

    <GlassCard title="Engagement Formats">
      <ul class="mt-4 space-y-3 text-slate-300">
        {
          engagements.map((item) => (
            <li><strong class="text-white">{item.title}:</strong> {item.description}</li>
          ))
        }
      </ul>
    </GlassCard>
  </section>

  <section class="mt-10 rounded-2xl border border-cyan-300/20 bg-cyan-300/5 p-5 md:mt-12 md:p-8">
    <SectionHeader
      titleTag="h2"
      title="Let’s build the right thing, not just the next thing."
      description="If you are planning a website refresh, a business application, or a full product build, we can help you scope it clearly and execute it with confidence."
      class="space-y-3"
      titleClass="text-2xl font-semibold text-white sm:text-3xl"
      descriptionClass="max-w-3xl text-base text-slate-300 sm:text-lg"
    />
    <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href="/contact" class="btn-primary w-full sm:w-auto">Start a Project Conversation</a>
      <a href="/services" class="btn-secondary w-full sm:w-auto">Review Services & Pricing</a>
    </div>
  </section>
</Layout>
