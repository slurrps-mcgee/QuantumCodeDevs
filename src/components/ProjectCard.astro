---
import type { Project } from "../data/types";
import { aosAttrs } from "../lib/aos";

interface Props {
  project: Project;
  delayIndex?: number;
}

const { project, delayIndex = 0 } = Astro.props;
---

<a
  href={`/work/${project.slug}`}
  class="group surface-card flex h-full flex-col overflow-hidden p-0"
  {...aosAttrs("fadeInUp", delayIndex)}
>
  <div class="p-5">
    <p class="kicker">{project.type}</p>
    <p class="mt-2 font-display text-xl font-semibold">{project.title}</p>
    {
      project.image && (
        <img
          src={project.image}
          alt=""
          class="mt-3 h-60 w-full rounded-lg object-cover object-top"
        />
      )
    }
  </div>
  <div class="flex flex-1 flex-col px-5 pb-5">
    <p class="text-sm text-mauve">{project.origin}</p>
    <p class="mt-2 flex-1 text-muted">{project.summary}</p>
    <p class="mt-4 text-sm font-semibold text-cta group-hover:underline">
      View project <span aria-hidden="true">→</span>
    </p>
  </div>
</a>
