---
import "./Typewriter.css";

interface Props {
  text: string;
  typeSpeed?: number;
}

const { text, typeSpeed = 100 } = Astro.props;
const plainText = text.replace(/<[^>]+>/g, "");
---

<span class="typewriter" data-type-speed={typeSpeed}>
  <span class="typewriter-sizer" aria-hidden="true">
    <span class="typewriter-html" set:html={text} />
    <span class="typewriter-cursor"></span>
  </span>
  <span class="typewriter-live" aria-hidden="true">
    <span class="typewriter-typed"></span>
    <span class="typewriter-cursor"></span>
    <span class="typewriter-rest" set:html={text} />
  </span>
  <span class="sr-only">{plainText}</span>
</span>

<script is:inline src="/scripts/typewriter.js"></script>
