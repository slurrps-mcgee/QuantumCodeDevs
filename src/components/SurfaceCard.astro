---
import { aosAttrs, type EntranceAnimation } from "../lib/aos";

interface Props {
  as?: "article" | "div" | "section" | "aside";
  title?: string;
  titleTag?: "h2" | "h3";
  class?: string;
  titleClass?: string;
  bodyClass?: string;
  animate?: boolean;
  animation?: EntranceAnimation;
  delayIndex?: number;
}

const {
  as = "article",
  title,
  titleTag = "h2",
  class: className = "",
  titleClass = "text-2xl font-semibold",
  bodyClass = title ? "mt-3 text-muted" : "",
  animate = false,
  animation = "fadeIn",
  delayIndex = 0,
  ...rest
} = Astro.props;

const Tag = as;
const TitleTag = titleTag;
---

<Tag
  {...rest}
  class:list={["surface-card", className]}
  {...animate ? aosAttrs(animation, delayIndex) : {}}
>
  {title && <TitleTag class={titleClass}>{title}</TitleTag>}
  <div class={bodyClass}>
    <slot />
  </div>
</Tag>
