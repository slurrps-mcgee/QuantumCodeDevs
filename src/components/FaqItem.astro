---
import { aosAttrs } from "../lib/aos";

interface Props {
  question: string;
  delayIndex?: number;
}

const { question, delayIndex = 0 } = Astro.props;
---

<details class="faq-item" {...aosAttrs("fadeIn", delayIndex)}>
  <summary class="faq-summary font-display">
    <span>{question}</span>
    <span class="faq-icon" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="h-5 w-5"
      >
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </span>
  </summary>
  <div class="faq-body">
    <slot />
  </div>
</details>
