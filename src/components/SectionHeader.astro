---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
  titleTag?: 'h1' | 'h2' | 'h3';
  eyebrowClass?: string;
  titleClass?: string;
  descriptionClass?: string;
}

const {
  eyebrow,
  title,
  description,
  class: className = '',
  titleTag = 'h1',
  eyebrowClass = 'inline-flex max-w-full text-wrap rounded-full border border-cyan-200/30 bg-cyan-200/10 px-3 py-1 text-xs font-medium uppercase tracking-wide text-cyan-100 sm:px-4 sm:tracking-[0.22em]',
  titleClass = 'text-3xl font-semibold leading-tight text-white sm:text-4xl md:text-5xl',
  descriptionClass = 'max-w-3xl text-base text-slate-300 sm:text-lg'
} = Astro.props as Props;

const TitleTag = titleTag;
---

<div class:list={['space-y-4 sm:space-y-5', className]}>
  {eyebrow && <p class={eyebrowClass}>{eyebrow}</p>}
  <TitleTag class={titleClass}>{title}</TitleTag>
  {description && <p class={descriptionClass}>{description}</p>}
  <slot />
</div>
